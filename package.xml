<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>erdi_lrf_ros2</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for ERDI UART laser rangefinder modules (905 nm, up to
    several kilometres of range). Publishes the distance sensor reading as
    sensor_msgs/msg/Range for both published ERDI serial protocol families.
  </description>
  <maintainer email="tommy@erdimail.com">ERDI Technology</maintainer>
  <license>MIT</license>
  <url type="website">https://erdilrf.com</url>
  <url type="repository">https://github.com/ErdiTech/erdi_lrf_ros2</url>
  <url type="bugtracker">https://github.com/ErdiTech/erdi_lrf_ros2/issues</url>
  <author email="tommy@erdimail.com">ERDI Technology</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
